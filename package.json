{
  "name": "headplay",
  "version": "0.1.0",
  "private": true,
  "description": "HEADPLAY — Phase 1 webcam eye blink & gaze recognition technical validation (Chrome MV3)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "fetch-model": "node scripts/fetch-model.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.312",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
