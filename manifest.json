{
  "manifest_version": 3,
  "name": "HEADPLAY (Phase 1 — Tech Validation)",
  "version": "0.1.0",
  "description": "Local webcam eye blink & gaze recognition validation for Chrome MV3 background/minimized execution.",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "HEADPLAY Phase 1 Validator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
